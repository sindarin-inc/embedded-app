#pragma once

#include "config.h"

#include "sindarin-debug.h"

enum FontType {  
#if IBMF_SUPPORT
IBMF
#endif
#if TTF_SUPPORT
TTF
#endif
};

class Font {
private:
    FontType type_;

public:
    virtual ~Font() = default;
    [[nodiscard]] auto isA(FontType fontType) const -> bool { return fontType == type_; }
    [[nodiscard]] virtual auto lineHeight() const -> int = 0;

protected:
    Font(FontType fontType) : type_(fontType) {}
};
