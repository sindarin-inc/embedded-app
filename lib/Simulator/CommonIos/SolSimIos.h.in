#pragma once

#include <Foundation/Foundation.h>

// simulator-common definitions
// clang-format off
@SIMULATOR_DEFINITIONS@
    // clang-format on

    // Add these button types above the @interface
    typedef NS_ENUM(NSInteger, SolRemoteButton) {
        SolRemoteButtonNorth,
        SolRemoteButtonEast,
        SolRemoteButtonWest,
        SolRemoteButtonSouth,
        SolRemoteButtonEnter
    };

#ifdef __cplusplus
extern "C" {
